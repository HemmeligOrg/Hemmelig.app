{
    "name": "hemmelig-app",
    "version": "7.0.0",
    "description": "Share secrets securely with encrypted messages that automatically self-destruct after being read.",
    "type": "module",
    "main": "dist/app.js",
    "scripts": {
        "build": "npx vite build",
        "start": "npx prisma migrate deploy && npx tsx dist/app.js",
        "dev:api": "npx prisma migrate dev && npx tsx --watch server.ts",
        "dev:client": "npx vite",
        "dev": "npm run dev:client",
        "migrate:dev": "npx prisma migrate dev",
        "migrate:deploy": "npx prisma migrate deploy",
        "migrate:reset": "npx prisma migrate reset",
        "migrate:status": "npx prisma migrate status",
        "set:admin": "npx tsx scripts/admin.ts",
        "seed:demo": "npx tsx scripts/seed-demo.ts",
        "deploy": "npm run build && npm run migrate:deploy && npm run start",
        "test": "hurl api/tests",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
    },
    "keywords": [
        "react",
        "vite",
        "hono",
        "secrets",
        "encryption",
        "privacy",
        "security"
    ],
    "dependencies": {
        "@hono/node-server": "^1.14.4",
        "@hono/swagger-ui": "^0.5.2",
        "@hono/zod-openapi": "^1.1.5",
        "@hono/zod-validator": "^0.5.0",
        "@prisma/adapter-better-sqlite3": "7",
        "@prisma/client": "7",
        "argon2": "^0.44.0",
        "better-auth": "^1.4.4",
        "better-sqlite3": "^12.0.0",
        "croner": "^9.1.0",
        "dlv": "^1.1.3",
        "dotenv": "^17.2.3",
        "hono": "^4.7.9",
        "hono-rate-limiter": "^0.4.2",
        "ip-address": "^10.0.1",
        "ip-range-check": "^0.2.0",
        "is-cidr": "^5.1.1",
        "is-ip": "^5.0.1",
        "isbot": "^5.1.32",
        "nanoid": "^5.1.6",
        "prisma": "7",
        "ua-parser-js": "^2.0.4",
        "validator": "^13.15.15",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@hono/vite-dev-server": "^0.19.1",
        "@tabler/icons-react": "^3.34.0",
        "@tailwindcss/typography": "^0.5.16",
        "@tiptap/extension-character-count": "^2.22.3",
        "@tiptap/extension-color": "^2.22.3",
        "@tiptap/extension-link": "^2.22.3",
        "@tiptap/extension-list-item": "^2.22.3",
        "@tiptap/extension-text-style": "^2.22.3",
        "@tiptap/react": "^2.22.3",
        "@tiptap/starter-kit": "^2.22.3",
        "@types/dlv": "^1.1.5",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@types/validator": "^13.15.2",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.18",
        "clsx": "^2.1.0",
        "eslint": "^9.9.1",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "generate-password-browser": "^1.1.0",
        "globals": "^15.9.0",
        "husky": "^9.1.7",
        "i18next": "^25.2.1",
        "i18next-browser-languagedetector": "^8.2.0",
        "lint-staged": "^16.2.7",
        "lucide-react": "^0.523.0",
        "postcss": "^8.4.35",
        "prettier": "^3.7.4",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-prisma": "^5.0.0",
        "qrcode.react": "^4.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-dropzone": "^14.3.8",
        "react-i18next": "^15.5.3",
        "react-router-dom": "^6.20.1",
        "recharts": "^3.0.2",
        "sonner": "^2.0.6",
        "tailwindcss": "^3.4.1",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.3.0",
        "vite": "^7.2.7",
        "zustand": "^5.0.6"
    },
    "prisma": {
        "schema": "prisma/schema.prisma"
    }
}
